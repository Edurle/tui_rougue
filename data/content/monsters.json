{
  "_schema": {
    "说明": "山海经异兽定义。components 里的键对应代码中的组件注册表（content_loader.py），新增行为=新组件类+注册+此处引用。tags 为预留扩展字段：五行/阴阳/出处卷目（卷目 tag 与 regions.json 对应，供投放匹配）。name/lore 支持两种写法：字符串（所有语言同值）或 {\"zh_CN\": …, \"en_US\": …}，缺失语言回退 zh_CN。",
    "字段": {
      "name": "显示名（可本地化）",
      "char": "地图字符",
      "color": "[R, G, B]",
      "tags": "扩展标签（shanhaijing=山海经, 卷目, 五行等）",
      "lore": "典故出处（可本地化）",
      "components.fighter": "战斗组件：hp/power/defense/xp_reward",
      "components.ai": "AI 行为，type 对应 ai.py 注册表",
      "resistances": "抗性表 {thunder|fire|poison|stun: 百分比 0-80}：元素减伤 / 眩晕时长缩短",
      "attack_tags": "普攻附带元素（thunder/fire/poison），命中按目标抗性折算"
    }
  },
